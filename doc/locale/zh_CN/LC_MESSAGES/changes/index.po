#: ../../changes/index.md:1 1ba98d692ba84df381266f8bf43a083b
msgid "Change Proposals"
msgstr "变更提案"

#: ../../changes/index.md:3 501204cb66b045cd9f85a8e1274e1ce0
msgid ""
"This directory contains change proposals following the OpenSpec workflow."
msgstr "本目录包含遵循 OpenSpec 工作流的变更提案。"

#: ../../changes/index.md:5 858b2fa4d0c14942ad183ebf471bcb2c
msgid "What is a Change Proposal?"
msgstr "什么是变更提案？"

