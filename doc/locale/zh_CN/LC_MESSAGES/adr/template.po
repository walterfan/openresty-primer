#: ../../adr/template.md:1 542bcffc40744221b364be5ca68f6bf3
msgid "ADR-XXXX: [Title]"
msgstr "ADR-XXXX：[标题]"

#: ../../adr/template.md:7 7523f9534d2e4e5fa66132d52546e30a
msgid "Status"
msgstr "状态"

#: ../../adr/template.md:9 8292d75102cf45f7936a22fef2d8bbab
msgid "[Proposed | Accepted | Deprecated | Superseded]"
msgstr "[提议 | 已接受 | 已废弃 | 已被取代]"

#: ../../adr/template.md:11 ec254d3d4178437c9db450d4f56f08b5
msgid "Proposed: [Date]"
msgstr "提议：[日期]"

#: ../../adr/template.md:12 f56e3f42de5445e7b7afbd971ffc6d08
msgid "Accepted: [Date]"
msgstr "已接受：[日期]"

#: ../../adr/template.md:13 293d294998264de6a97fa39ce7eb95be
msgid "Deprecated: [Date]"
msgstr "已废弃：[日期]"

#: ../../adr/template.md:14 ../../adr/template.md:162
#: 32950d07ff664da18d35b39968753687 535d60c056c944088b1067223ea6fa42
msgid "Superseded by: ADR-XXXX"
msgstr "已被 ADR-XXXX 取代"

#: ../../adr/template.md:16 8b3c2c3753d9419ead3896ce49303c43
msgid "Context — Why This Decision Matters"
msgstr "上下文——为什么这个决策很重要"

#: ../../adr/template.md:18 9c19ca12b2d54cc09eaee653ea676c2c
msgid ""
"[Describe the context and problem statement. Focus on **why** this decision "
"is needed now — what changed, what pressure exists, what happens if we do "
"nothing. The \"what\" is in the Decision section; this section is about the "
"forces driving the choice.]"
msgstr ""
"[描述上下文和问题陈述。重点讲**为什么**现在需要这个决策——发生了什么变化、存在什么压力、如果不做会怎样。\"是什么\"在决策章节；本节讲驱动选择的力。]"

#: ../../adr/template.md:20 2bcc217053024ea9a389e21aa180170f
msgid "Problem"
msgstr "问题"

#: ../../adr/template.md:22 179cd7cccf164eadaf8a65b17611d949
msgid ""
"[Clear statement of the problem being addressed. Explain why it is a problem"
" — not just what is broken, but what impact it has on users, team velocity, "
"reliability, or cost.]"
msgstr "[清晰陈述要解决的问题。解释它为什么是问题——不只是哪里坏了，还包括它对用户、团队速度、可靠性或成本的影响。]"

#: ../../adr/template.md:24 31ac1815371c480f9fca075705797802
msgid "Constraints"
msgstr "约束"

#: ../../adr/template.md:26 d4c4e0037e704dc09c3a9f27faa69df7
msgid "Constraint 1: [e.g., Must work with existing infrastructure]"
msgstr "约束 1：[例如：必须与现有基础设施协同工作]"

#: ../../adr/template.md:27 706a7807e46445f48e5659d55a01a65d
msgid "Constraint 2: [e.g., Budget limit of $X]"
msgstr "约束 2：[例如：预算上限 $X]"

#: ../../adr/template.md:28 0a7ddc9c3c2745cc92941b1456a4bd30
msgid "Constraint 3: [e.g., Timeline of Y weeks]"
msgstr "约束 3：[例如：Y 周的时间线]"

#: ../../adr/template.md:30 47e9076141934218b7b6ecfe9debfa12
msgid "Goals"
msgstr "目标"

#: ../../adr/template.md:32 41d009ff0c1e4001820c66a03479c7c2
msgid "Goal 1: [What we want to achieve]"
msgstr "目标 1：[我们要达到什么]"

#: ../../adr/template.md:33 56d186ac29c64d61931a23b3909bccda
msgid "Goal 2: [What we want to achieve]"
msgstr "目标 2：[我们要达到什么]"

#: ../../adr/template.md:35 050064da440741fdbd5ab4f510b272a3
msgid "Non-Goals"
msgstr "非目标"

#: ../../adr/template.md:37 a5e9216510cd4e1a89b162c86fa03785
msgid "Non-goal 1: [What we explicitly do NOT want to address]"
msgstr "非目标 1：[我们明确不想处理的内容]"

#: ../../adr/template.md:38 803c5994f3fe442c8366f8aa4af125a9
msgid "Non-goal 2: [What we explicitly do NOT want to address]"
msgstr "非目标 2：[我们明确不想处理的内容]"

#: ../../adr/template.md:40 e34b8845327c419694677c164b54e133
msgid "Decision"
msgstr "决策"

#: ../../adr/template.md:42 d8bfec7941444a3786885d4681c95c8a
msgid ""
"[Describe the decision that was made. Be specific and clear. Then explain "
"**why this option was chosen over the alternatives** — this is the most "
"valuable sentence in the entire ADR.]"
msgstr "[描述已做出的决策。要具体清晰。然后解释**为什么选择该选项而不是其他备选**——这是整份 ADR 中最有价值的一句话。]"

#: ../../adr/template.md:44 430ff306bcc4440b9752874c3113f1f9
msgid "Summary"
msgstr "摘要"

#: ../../adr/template.md:46 adfc81c5060e41368f9c59a25d69e541
msgid "[One-paragraph summary of the decision]"
msgstr "[决策的一段话摘要]"

#: ../../adr/template.md:48 1f7c4a6181d348c1b9b7d4662b8b2349
msgid "Details"
msgstr "详情"

#: ../../adr/template.md:50 5d24cea19bb24b738ab5c9bd1e97965d
msgid ""
"[More detailed explanation if needed. Include diagrams, code examples, etc.]"
msgstr "[如需要可提供更详细的说明，包括图表、代码示例等。]"

