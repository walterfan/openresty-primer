msgstr "从错误的当前目录启动"

#: ../../01-quick-start.md 74c38171da19403ea53c70fdd51c9dae
msgid "Run `nginx` with `-p` pointing at the scratch dir"
msgstr "用 `-p` 指向临时目录来运行 `nginx`"

#: ../../01-quick-start.md e7307bbeef4a4309b4e99dd9d38c980a
msgid "`curl` gets a persistent 502/empty body"
msgstr "`curl` 持续得到 502/空响应体"

