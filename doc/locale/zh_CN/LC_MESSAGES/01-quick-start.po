msgstr "`resty -e 'print(1)'`"

#: ../../01-quick-start.md e7d315a3957d47dfb418d35d334a25e1
msgid ""
"In `PATH` by default with official packages; otherwise add "
"`/usr/local/openresty/bin` to `PATH`"
msgstr "使用官方包时默认在 `PATH` 中；否则请把 `/usr/local/openresty/bin` 加入 `PATH`"

#: ../../01-quick-start.md eb05bacca2e4482f992efd02175e2731
msgid "pcre/zlib/openssl dev headers"
msgstr "pcre/zlib/openssl 开发头文件"

