#: ../../appendix-02-glossary.md abea46bbf4f641508ef16e8195539032
msgid "Cosocket"
msgstr "Cosocket"

#: ../../appendix-02-glossary.md 19cecbf40c884c668810d74e063925fc
msgid "Nonblocking socket driven by ngx_lua on the Nginx event loop"
msgstr "由 ngx_lua 在 Nginx 事件循环上驱动的非阻塞套接字"

#: ../../appendix-02-glossary.md f5e0b71fb096406d82edd860458d912d
msgid "`ngx.socket.tcp():connect()`"
msgstr "`ngx.socket.tcp():connect()`"

#: ../../appendix-02-glossary.md a4286925b7014a38a75d69bfec289bfd
msgid "Light thread"
msgstr "Light thread（轻线程）"

#: ../../appendix-02-glossary.md 3e639ba12fe84c6b9bb61ead08737715
msgid "A coroutine scheduled by ngx_lua within a request"
msgstr "由 ngx_lua 在请求内调度的协程"

#: ../../appendix-02-glossary.md 9460a6b19bf84fb0b79a95bb105c9ecd
msgid "`ngx.thread.spawn`; cooperative, not preemptive"
msgstr "`ngx.thread.spawn`；协作式，非抢占式"

#: ../../appendix-02-glossary.md 9d344911e1654a9dba41692a58af8e82
msgid "`lua_shared_dict`"
msgstr "`lua_shared_dict`"

#: ../../appendix-02-glossary.md 32e14b56d7da4198b372abd9018119b5
msgid "Per-worker shared memory dictionary"
msgstr "按 worker 共享的内存字典"

#: ../../appendix-02-glossary.md 7a76b9089c8b4597ab9c80c7014d0daa
msgid "`ngx.shared.DICT`; no cross-worker sharing"
msgstr "`ngx.shared.DICT`；不跨 worker 共享"

#: ../../appendix-02-glossary.md 1d013aff54e94810a1378424c4e67eae
msgid "Coroutine"
msgstr "协程"

#: ../../appendix-02-glossary.md e2dfb755584148bd93aed4d96367128b
msgid "Cooperative execution context in Lua"
msgstr "Lua 中的协作式执行上下文"

#: ../../appendix-02-glossary.md 9f00b070b5c843ca8a46b44f3b0f31b4
msgid "Yields explicitly; integrated with Nginx's event loop"
msgstr "显式让出；与 Nginx 事件循环集成"

#: ../../appendix-02-glossary.md 27eb676d4c2f49fdb2c077f8b204cff5
msgid "Closure"
msgstr "闭包"

#: ../../appendix-02-glossary.md 2707ed88fa06491a97e260f3b8b1fdc3
msgid "Function capturing enclosing locals"
msgstr "捕获外层局部变量的函数"

#: ../../appendix-02-glossary.md 3738ac4722b445a8961a2e88ed74a771
msgid "Drives module state and worker-local caches"
msgstr "承载模块状态与 worker 本地缓存"

#: ../../appendix-02-glossary.md dd58f941c8bc44c6b6ed581aafb10ada
msgid "Metatable / metamethod"
msgstr "元表 / 元方法"

#: ../../appendix-02-glossary.md 78bc71daba784a4dacf669c08e387195
msgid "Customizes table/userdata operations"
msgstr "定制表/userdata 的操作"

#: ../../appendix-02-glossary.md 19a713a4572d4e7aadf720d246c64d37
msgid "`__index`, `__newindex`, `__tostring`, `__gc`"
msgstr "`__index`、`__newindex`、`__tostring`、`__gc`"

#: ../../appendix-02-glossary.md be8b42419c1340beb60404eaf1bebb50
msgid "FFI"
msgstr "FFI"

#: ../../appendix-02-glossary.md b493b9291b6747ce94172d369e937cdd
msgid "LuaJIT foreign-function interface to C"
msgstr "LuaJIT 面向 C 的外部函数接口"

#: ../../appendix-02-glossary.md 8bffedc9a06b4309b13b3356e9ae5f47
msgid "`ffi.*`; crosses the C boundary"
msgstr "`ffi.*`；跨越 C 边界"

#: ../../appendix-02-glossary.md 137421be43f843d38404c7a2ba034eee
msgid "JIT trace"
msgstr "JIT trace"

#: ../../appendix-02-glossary.md b89e8fd713504dd298dab68ae07bd4e7
msgid "Recorded hot execution path compiled to machine code"
msgstr "被记录并编译为机器码的热执行路径"

#: ../../appendix-02-glossary.md 57d40f6d84b04144ae1e4d5f8873bd56
msgid "LuaJIT tracing JIT"
msgstr "LuaJIT 追踪式 JIT"

#: ../../appendix-02-glossary.md 1dd4d6e0b22148d3bf9290768ff4ef28
msgid "`resolver`"
msgstr "`resolver`"

#: ../../appendix-02-glossary.md 2066d86771c54318a739de3763cd8398
msgid "Directive that supplies nameserver addresses to `ngx_resolver`"
msgstr "向 `ngx_resolver` 提供域名服务器地址的指令"

#: ../../appendix-02-glossary.md b4ff42992e3f439998014c46e59945d8
msgid "Required for hostname connects. No libc fallback."
msgstr "主机名连接必需。没有 libc 回退。"

#: ../../appendix-02-glossary.md 4e9b0d63d8ff44bf9030f0657723ef91
msgid "`resolver_timeout`"
msgstr "`resolver_timeout`"

#: ../../appendix-02-glossary.md 65111c1b477a42cc962dec534258d764
msgid "Absolute timeout for one resolve context"
msgstr "单个解析上下文的绝对超时"

#: ../../appendix-02-glossary.md 74d13ca7071c4a1191c42585714076cd
msgid "Default 30000 ms. Distinct from the 5 second resend interval."
msgstr "默认 30000 ms。与 5 秒重发间隔不同。"

#: ../../appendix-02-glossary.md 31e756ce6fa047bf9bf8777c7a3a1ee1
msgid "`valid=`"
msgstr "`valid=`"

#: ../../appendix-02-glossary.md 723fe55aac18401e8f90b51363f60a9a
