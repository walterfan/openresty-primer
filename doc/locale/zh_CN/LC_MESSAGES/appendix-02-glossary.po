msgstr "覆盖成功应答可被缓存的时长"

#: ../../appendix-02-glossary.md 0b56770e64b646d69daac61be9d48342
msgid ""
"Omitted means the record TTL. Not a negative-cache TTL in the name rbtree."
msgstr "省略时表示记录 TTL。不是名称红黑树中的负缓存 TTL。"

#: ../../appendix-02-glossary.md 2fdf395d56474424a6d32532ab117ff9
msgid "RCODE"
msgstr "RCODE"

#: ../../appendix-02-glossary.md aa4a55136e004b5c802e7da8fca8263d
