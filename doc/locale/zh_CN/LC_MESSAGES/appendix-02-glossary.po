msgid "`NGX_RESOLVER_MAX_RECURSION`"
msgstr "`NGX_RESOLVER_MAX_RECURSION`"

#: ../../appendix-02-glossary.md 206a158e908242148eab7d78f49495d4
msgid "CNAME chase limit"
msgstr "CNAME 追踪限制"

#: ../../appendix-02-glossary.md 1c1a87bfd5a94bc096befd5f6faef281
msgid "50. The next chase fails with NXDOMAIN."
msgstr "50。再往下追踪会以 NXDOMAIN 失败。"

#: ../../appendix-02-glossary.md 7ba588b71b0c423994358ad993994545
msgid "Nameserver rotation"
msgstr "域名服务器轮换"

#: ../../appendix-02-glossary.md b3a32522fafc4a38bafdbac1f25208c7
msgid "Next `resolver` address after a send failure or a resend timeout"
msgstr "发送失败或重发超时后的下一个 `resolver` 地址"

