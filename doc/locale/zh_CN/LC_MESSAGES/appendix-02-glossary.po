msgstr "DNS 响应标志的低 4 位"

#: ../../appendix-02-glossary.md 9d127b10e8cf417d9055912b77786912
msgid "0 NOERROR, 1 FORMERR, 2 SERVFAIL, 3 NXDOMAIN, 4 NOTIMP, 5 REFUSED"
msgstr "0 NOERROR，1 FORMERR，2 SERVFAIL，3 NXDOMAIN，4 NOTIMP，5 REFUSED"

#: ../../appendix-02-glossary.md 57ede54cf1f24d928d710915670e5652
msgid "`NGX_RESOLVE_TIMEDOUT`"
msgstr "`NGX_RESOLVE_TIMEDOUT`"

#: ../../appendix-02-glossary.md ad23055542da4ee696f0d6b6bb8a40db
msgid "`ctx->state` after `resolver_timeout`"
msgstr "`resolver_timeout` 之后的 `ctx->state`"

#: ../../appendix-02-glossary.md e60c9e5c5a2748458fa9f794e0b16f87
msgid "Same value as `ETIMEDOUT`. String is `Operation timed out`."
msgstr "与 `ETIMEDOUT` 相同。字符串为 `Operation timed out`。"

#: ../../appendix-02-glossary.md dab8d0fc5daf46dfb9f5d3251fdd9487
msgid "`rn->waiting`"
msgstr "`rn->waiting`"

#: ../../appendix-02-glossary.md a7976856eda744079b46775f028275bc
msgid "Linked list of contexts waiting on one name"
msgstr "等待同一个名称的上下文链表"

#: ../../appendix-02-glossary.md b0a9497fdd1d4f2095c82c9eb09c192e
msgid "All of them fail together on a terminal RCODE"
msgstr "遇到终态 RCODE 时它们一起失败"

