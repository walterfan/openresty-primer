msgid "Not triggered by SERVFAIL"
msgstr "不由 SERVFAIL 触发"

#: ../../appendix-02-glossary.md 44257a67330d446993d79ac281eeb893
msgid "SNI"
msgstr "SNI"

#: ../../appendix-02-glossary.md 41df1201269e4086911c6d4601475f0a
