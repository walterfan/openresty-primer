msgstr "把 LuaJIT 嵌入 Nginx 的 Web 平台"

#: ../../appendix-02-glossary.md b322c7ce69424fe0a1cbd80344e649f3
msgid "`lua-nginx-module` is its core; not an Nginx fork"
msgstr "`lua-nginx-module` 是它的核心；不是 Nginx 的分支"

#: ../../appendix-02-glossary.md 86233ae23cb64cc0b03d7cfb93b8ca7a
msgid "LuaJIT"
msgstr "LuaJIT"

#: ../../appendix-02-glossary.md 93c2ca2eede743db97e87f49d70a02f0
msgid "Lua 5.1-compatible VM with a tracing JIT"
msgstr "兼容 Lua 5.1、带追踪式 JIT 的虚拟机"

#: ../../appendix-02-glossary.md 9a710051669a459bbf0591690d61b2d8
msgid "Used by OpenResty; FFI and `bit` extensions"
msgstr "OpenResty 所用；包含 FFI 和 `bit` 扩展"

#: ../../appendix-02-glossary.md 3c453382862144de83149251a0ec391f
msgid "ngx_lua"
msgstr "ngx_lua"

#: ../../appendix-02-glossary.md 625cc9d2e06a4a50a788275524f0b50d
msgid "`lua-nginx-module`; embeds Lua handlers into Nginx phases"
msgstr "`lua-nginx-module`；把 Lua 处理器嵌入 Nginx 各阶段"

#: ../../appendix-02-glossary.md dc54fd8ea1374add805c151c0a0e0a00
msgid "Also called \"the Lua module\" of OpenResty"
msgstr "也称作 OpenResty 的 “Lua 模块”"

#: ../../appendix-02-glossary.md 074b2e0b686e4aabaf2b611b00cb0e67
msgid "Nginx API for Lua"
msgstr "Nginx API for Lua"

#: ../../appendix-02-glossary.md 01bc03f4fb474ad6b26538165dc03bec
msgid "The `ngx.*` surface from Lua"
msgstr "从 Lua 看到的 `ngx.*` 接口"

#: ../../appendix-02-glossary.md f84b212aec8249f695f25fbe8c8d8321
msgid "`ngx.var`, `ngx.req.*`, `ngx.location.capture`, `ngx.say`, ..."
