msgid "**syntax:** *ngx.req.init_body(buffer_size?)*"
msgstr "**语法**：*ngx.req.init_body(buffer_size?)*"

#: ../../08-lua-nginx-module.md:5761 ../../08-lua-nginx-module.md:5792
#: ../../08-lua-nginx-module.md:5812 ../../08-lua-nginx-module.md:6031
