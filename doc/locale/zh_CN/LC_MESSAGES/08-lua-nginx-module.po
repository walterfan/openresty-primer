msgstr "**语法**：*ngx.update_time()*"

#: ../../08-lua-nginx-module.md:6582 35c1457ca8fc4feb9091cc81a295b5ea
msgid ""
"Forcibly updates the Nginx current time cache. This call involves a "
"syscall and thus has some overhead, so do not abuse it."
msgstr ""

#: ../../08-lua-nginx-module.md:6588 34c315bf24454aa19dc1aa096eb62da5
