#: ../../08-lua-nginx-module.md:6628 66f717b7407441519112aafba2ce70a6
msgid "ngx.http_time"
msgstr ""

#: ../../08-lua-nginx-module.md:6630 277c68b367924d10a726bf50f5ac990b
