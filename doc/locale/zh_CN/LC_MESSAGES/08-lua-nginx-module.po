#: 7c2bec2b429a4560ba43aa61758b8d7d 998d0b07756d4e2f809d968729c16231
msgid "This directive was first introduced in the `v0.10.21` release."
msgstr ""

#: ../../08-lua-nginx-module.md:2731 c870058f3d7c4da2aecefe3df5b339c3
