msgid ""
"Note: this function throws a Lua error if `header_name` or `header_value`"
" contain unsafe characters (control characters)."
msgstr ""

#: ../../08-lua-nginx-module.md:5602 e258c45c83534849ac66ffe6e8aa2922
msgid "ngx.req.clear_header"
msgstr ""

#: ../../08-lua-nginx-module.md:5604 f39cb13558fc4b19bc5fc649abfbb5f8
