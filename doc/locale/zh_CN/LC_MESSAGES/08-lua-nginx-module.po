msgstr ""

#: ../../08-lua-nginx-module.md:5565 a28d54adb8fe4fe6bab2fa387ffc1f7c
msgid "The `header_value` can take an array list of values, for example,"
msgstr ""

#: ../../08-lua-nginx-module.md:5573 77e286d7d4b14098a0026119aefe6d32
msgid "will produce two new request headers:"
msgstr ""

#: ../../08-lua-nginx-module.md:5581 ee3c7cf1529443189e741fd4afe2f3b1
msgid "and old `Foo` headers will be overridden if there is any."
msgstr ""

