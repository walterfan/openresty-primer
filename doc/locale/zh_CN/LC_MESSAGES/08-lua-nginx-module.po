msgid ""
"This directive can be freely mixed with all directives of the "
"[ngx_http_rewrite_module](http://nginx.org/en/docs/http/ngx_http_rewrite_module.html),"
" [set-misc-nginx-module](http://github.com/openresty/set-misc-nginx-"
"module), and [array-var-nginx-module](http://github.com/openresty/array-"
"var-nginx-module) modules. All of these directives will run in the same "
"order as they appear in the config file."
msgstr ""

#: ../../08-lua-nginx-module.md:1746 2af1919e937440f5a685eb57f547677c
msgid "No special escaping is required in the Lua code block."
msgstr ""

