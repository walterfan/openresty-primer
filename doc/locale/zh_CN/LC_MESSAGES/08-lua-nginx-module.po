msgstr ""

#: ../../08-lua-nginx-module.md:2733 476deb4f7a56496ebbdcab61ef27a6fc
msgid "**syntax:** *lua_need_request_body &lt;on|off&gt;*"
msgstr "**语法**：*lua_need_request_body &lt;on|off&gt;*"

#: ../../08-lua-nginx-module.md:2735 2920293b4e95461bb897b30757b25b39
msgid "**default:** *off*"
msgstr "**默认**：*off*"

#: ../../08-lua-nginx-module.md:2739 ../../08-lua-nginx-module.md:3304
#: ../../08-lua-nginx-module.md:3381 6642d57b393f40e7bad26b348244c735
#: 6b9b799ff15b4e9f916baccc94241605 b3fc654c6a424b4ab26c362ec2c66946
