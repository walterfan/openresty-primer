msgid ""
"Returns current date (in the format `yyyy-mm-dd`) from the Nginx cached "
"time (no syscall involved unlike Lua's date library)."
msgstr ""

#: ../../08-lua-nginx-module.md:6546 ../../08-lua-nginx-module.md:6596
#: 23dab52ad43a4a5aae94230cea9614b5 630b1555768941759c9e86c3cc0d0828
msgid "This is the local time."
msgstr ""

#: ../../08-lua-nginx-module.md:6550 37767fdc2182495287e73fbb80984cd8
msgid "ngx.time"
msgstr ""

#: ../../08-lua-nginx-module.md:6552 6542bd0a881749f0a10fea7b55700966
msgid "**syntax:** *secs = ngx.time()*"
msgstr "**语法**：*secs = ngx.time()*"

#: ../../08-lua-nginx-module.md:6556 588d688f762f4785b3668f2d2a5ad820
msgid ""
"Returns the elapsed seconds from the epoch for the current time stamp "
"from the Nginx cached time (no syscall involved unlike Lua's date "
"library)."
msgstr ""

#: ../../08-lua-nginx-module.md:6558 e7fcf2a7c9974955a5194d7de44dc637
msgid ""
"Updates of the Nginx time cache can be forced by calling "
"[ngx.update_time](#ngxupdate_time) first."
msgstr ""

#: ../../08-lua-nginx-module.md:6562 2fcb322b85624251bb1c2445ebf6c841
msgid "ngx.now"
msgstr ""

#: ../../08-lua-nginx-module.md:6564 8547396c25e14bab9e9ee4638b82e626
msgid "**syntax:** *secs = ngx.now()*"
msgstr "**语法**：*secs = ngx.now()*"

#: ../../08-lua-nginx-module.md:6568 b6f18451016a4cb0aa978e4f84c086b4
msgid ""
"Returns a floating-point number for the elapsed time in seconds "
"(including milliseconds as the decimal part) from the epoch for the "
"current time stamp from the Nginx cached time (no syscall involved unlike"
" Lua's date library)."
msgstr ""

#: ../../08-lua-nginx-module.md:6570 b714ac8bd4c94ce0a73e9faabda894f1
msgid ""
"You can forcibly update the Nginx time cache by calling "
"[ngx.update_time](#ngxupdate_time) first."
msgstr ""

#: ../../08-lua-nginx-module.md:6572 ../../08-lua-nginx-module.md:6584
#: 40bd382713cb4841a85fa7313e9a627c 72bddfe0bb4743a6b332f22f2160d6e9
