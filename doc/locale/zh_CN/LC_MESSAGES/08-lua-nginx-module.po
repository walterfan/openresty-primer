msgstr "**语法**：*lua_socket_pool_size &lt;size&gt;*"

#: ../../08-lua-nginx-module.md:3411 ac52b4e3b69b4183931aa5bbc70d52e8
msgid "**default:** *lua_socket_pool_size 30*"
msgstr "**默认**：*lua_socket_pool_size 30*"

#: ../../08-lua-nginx-module.md:3415 c678d7c8d4c34aacb496b4e1e4f39dc7
msgid ""
"Specifies the size limit (in terms of connection count) for every "
"cosocket connection pool associated with every remote server (i.e., "
"identified by either the host-port pair or the unix domain socket file "
"path)."
msgstr ""

#: ../../08-lua-nginx-module.md:3417 ac26cc0f14c64aa5bbbd664d8e5e8d1a
msgid "Default to 30 connections for every pool."
msgstr ""

#: ../../08-lua-nginx-module.md:3419 ac19a5bf9ab648d1a16cfdfaa13969e7
msgid ""
"When the connection pool exceeds the available size limit, the least "
"recently used (idle) connection already in the pool will be closed to "
"make room for the current connection."
msgstr ""

#: ../../08-lua-nginx-module.md:3421 cb6a39c874084a4196acc736807df992
msgid ""
"Note that the cosocket connection pool is per Nginx worker process rather"
" than per Nginx server instance, so size limit specified here also "
"applies to every single Nginx worker process."
msgstr ""

#: ../../08-lua-nginx-module.md:3427 445979f2313e4e6ab315961865079cac
msgid "lua_socket_keepalive_timeout"
msgstr ""

#: ../../08-lua-nginx-module.md:3429 9deef09be20b42a8af9ab11bd684ceaf
