msgstr ""

#: ../../08-lua-nginx-module.md:6425 7d29e35d9ae34696bbf0b1d87a7588e1
msgid "ngx.crc32_long"
msgstr ""

#: ../../08-lua-nginx-module.md:6427 9154630aa3d94b3495bc4eb64e118d1b
