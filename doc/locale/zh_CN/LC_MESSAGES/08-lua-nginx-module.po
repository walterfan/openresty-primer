msgstr "**默认**：*lua_socket_keepalive_timeout 60s*"

#: ../../08-lua-nginx-module.md:3435 dc764f7c21684f649c1f178393a44485
msgid ""
"This directive controls the default maximal idle time of the connections "
"in the cosocket built-in connection pool. When this timeout reaches, idle"
" connections will be closed and removed from the pool. This setting can "
"be overridden by cosocket objects' [setkeepalive](#tcpsocksetkeepalive) "
"method."
msgstr ""

#: ../../08-lua-nginx-module.md:3443 0ee6fa9f4aef413f922fe8c9d0fdcd75
msgid "lua_socket_log_errors"
msgstr ""

#: ../../08-lua-nginx-module.md:3445 c590a3f3c8a342f380fcc0ab9479af5e
